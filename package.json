{
  "name": "tokentracker",
  "version": "1.0.0",
  "description": "Privacy-first local token usage tracker for AI coding CLIs/IDEs (Claude Code, Codex, WorkBuddy, CodeBuddy, Qoder, Qwen, ZCode, OpenCode) — parses local session logs into SQLite and serves a token-focused web dashboard",
  "main": "dist/src/server.js",
  "bin": {
    "tokentracker": "bin/tokentracker.js"
  },
  "files": [
    "dist/src",
    "public/*.js",
    "public/*.html",
    "public/*.css",
    "public/vendor",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoudev49/TokenTracker.git"
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.frontend.json",
    "start": "node dist/src/server.js",
    "prestart": "npm run build",
    "dev": "concurrently -k -n backend,frontend,server \"tsc -p tsconfig.json -w\" \"tsc -p tsconfig.frontend.json -w\" \"nodemon --watch dist dist/src/server.js\"",
    "test": "npm run build && node --test dist/test/*.test.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "claude-code",
    "codex",
    "workbuddy",
    "codebuddy",
    "qoder",
    "qwen",
    "zcode",
    "opencode",
    "vibe-coding",
    "token-usage",
    "token-tracking",
    "token-counting",
    "sqlite",
    "dashboard",
    "privacy",
    "local-first"
  ],
  "author": "zhoudev49",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "concurrently": "^10.0.4",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  }
}
